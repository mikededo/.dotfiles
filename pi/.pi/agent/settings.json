{
  "theme": "pi-theme",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "defaultTools": [
    "+codemode",
    "+tool_search"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "packages": [
    "git:github.com/DietrichGebert/ponytail",
    "npm:@ff-labs/pi-fff",
    "npm:@tmustier/pi-usage-extension",
    "npm:@sting8k/pi-vcc",
    "npm:pi-archimedes"
  ],
  "editorPaddingX": 0,
  "quietStartup": true,
  "lastChangelogVersion": "1.1.0",
  "tuiMode": "fullscreen",
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6.1-sol",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-haiku-5-5"
  ],
  "hideThinkingBlock": false,
  "compaction": {
    "enabled": true,
    "reserveTokens": 68000,
    "modelOverrides": {
      "anthropic/claude-opus-5": {
        "reserveTokens": 128000
      },
      "anthropic/claude-fable-5-1": {
        "reserveTokens": 128000
      }
    }
  },
  "deviceId": "3ef1de87-ea6a-455f-b7e1-6a50a64a5026",
  "steeringMode": "one-at-a-time",
  "followUpMode": "all",
  "doubleEscapeAction": "tree",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "fullscreenExitOutput": "transcript",
  "archimedes.imagePaste": {
    "keybindingsPromptDone": true,
    "enabled": true
  },
  "archimedes.meta": {
    "onboarded": true
  },
  "archimedes.diff": {
    "diffTheme": "github-dark",
    "diffSplitMinWidth": 150,
    "diffSplitMinCodeWidth": 60,
    "diffSplitWrapCheck": true,
    "enabled": false
  },
  "archimedes.sudo": {
    "enabled": false
  },
  "archimedes.ui": {
    "animationStyle": "vertical-up",
    "autoCollapseThinking": false,
    "bashToolStyling": true,
    "codeUnindent": true,
    "codemodeToolStyling": true,
    "colorfulLogo": true,
    "editorSpinBorder": false,
    "editorSpinLabel": "Working",
    "editorSpinSpeed": "normal",
    "editorSpinStyle": "typing",
    "labelColor": "255,215,0",
    "labelText": "Thinking...",
    "mutedTheme": false,
    "thinkingStyle": "Full",
    "toolStyle": "Minimal"
  },
  "archimedes.footer": {
    "branchMaxLength": 50,
    "splitThreshold": 150
  },
  "archimedes.notify": {
    "delayMs": 30000,
    "notifyOnAgentEnd": true,
    "notifyOnQuestion": true
  },
  "archimedes.sessionName": {}
}
